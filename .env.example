# Copie para .env (nunca commite o .env). No Railway, defina em Variables.
NODE_ENV=development
PORT=8080
CMS_BASE_URL=https://cms.topenglish.com.br
# API do CMS: admin (padrão; /admin/auth/login e /admin/auth/me, como em cmsdev.topenglish.com.br) ou legado (API antiga de produção)
CMS_API=admin
# Só no modo legado: e-mails de franqueador (separados por vírgula), que liberam os demais em /acessos
GV_FRANQUEADORES=
# Só no modo legado, opcional: chave password_secret do CMS para o login v2 (senha só no corpo, assinada no servidor).
# Sem ela, o servidor usa o login v1 (GET /v1/authentication), sempre servidor-a-servidor em HTTPS.
CMS_PASSWORD_SECRET=
DATABASE_URL=postgres://usuario:senha@localhost:5432/geovenda
# IA (decisão D5a). Sem a chave, os recursos de IA ficam desligados.
ANTHROPIC_API_KEY=
AI_DAILY_CALLS=150
AI_MAX_TOKENS=8000
# Opcional: modelos por nível (confira os nomes atuais em https://docs.claude.com)
AI_MODEL_QUICK=
AI_MODEL_DEFAULT=
AI_MODEL_COMPLEX=
