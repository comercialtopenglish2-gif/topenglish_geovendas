# Copie para .env (nunca commite o .env). No Railway, defina em Variables.
NODE_ENV=development
PORT=8080
CMS_BASE_URL=https://cms.topenglish.com.br
DATABASE_URL=postgres://usuario:senha@localhost:5432/geovenda
# IA (decisão D5a). Sem a chave, os recursos de IA ficam desligados.
ANTHROPIC_API_KEY=
AI_DAILY_CALLS=150
AI_MAX_TOKENS=8000
# Opcional: modelos por nível (confira os nomes atuais em https://docs.claude.com)
AI_MODEL_QUICK=
AI_MODEL_DEFAULT=
AI_MODEL_COMPLEX=
